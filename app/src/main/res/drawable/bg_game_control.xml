<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/game_control_fill" />
            <stroke android:width="@dimen/game_control_checked_border_width" android:color="@color/game_control_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/game_control_fill" />
            <stroke android:width="@dimen/game_control_border_width" android:color="@color/game_control_stroke" />
        </shape>
    </item>
</selector>
